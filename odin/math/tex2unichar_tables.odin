	{"vdash", "⊢"},
	{"wasytherefore", "∴"},
}

// ``tex2unichar.mathunder``
@(rodata)
TEX2UNICHAR_MATHUNDER := [?]Str_Entry{
	{"underbrace", "⏟"},
}

// ``tex2unichar.space``
