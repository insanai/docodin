// ``FormulaConfig.bigbrackets``
@(rodata)
BIG_BRACKETS := [?]Pieces_Entry{
	{"(", {"⎛", "⎜", "⎝"}},
	{")", {"⎞", "⎟", "⎠"}},
	{"[", {"⎡", "⎢", "⎣"}},
	{"]", {"⎤", "⎥", "⎦"}},
	{"{", {"⎧", "⎪", "⎨", "⎩"}},
	{"|", {"|"}},
	{"}", {"⎫", "⎪", "⎬", "⎭"}},
	{"‖", {"‖"}},
}

// ``FormulaConfig.environments``
@(rodata)
ENVIRONMENTS := [?]Pieces_Entry{
	{"align", {"r", "l"}},
	{"eqnarray", {"r", "c", "l"}},
	{"gathered", {"l", "l"}},
	{"smallmatrix", {"c", "c"}},
}

// ``FormulaConfig.modified``
@(rodata)
MODIFIED := [?]Str_Entry{
	{"\u000a", ""},
	{" ", ""},
	{"$", ""},
	{"&", "\u0009"},
	{"'", "’"},
	{"+", "\u2009+\u2009"},
	{",", ",\u2009"},
	{"-", "\u2009−\u2009"},
	{"/", "\u2009⁄\u2009"},
	{":", " : "},
	{"<", "\u2009&lt;\u2009"},
	{"=", "\u2009=\u2009"},
	{">", "\u2009&gt;\u2009"},
	{"@", ""},
	{"~", "\u00a0"},
}

// ``FormulaConfig.unmodified['characters']``
UNMODIFIED :: ".*€()[]·!;|§\"?"

// ``AlphaCommand.greek_capitals`` (upright)
@(rodata)
GREEK_CAPITALS := [?]string{
	"\\Delta", "\\Gamma", "\\Lambda", "\\Omega", "\\Phi", "\\Pi", "\\Psi", "\\Sigma", "\\Theta",
	"\\Upsilon", "\\Xi",
}

// ``ContainerConfig.extracttext['extracted']``
@(rodata)
EXTRACTED_CLASSES := [?]string{
	"AlphaCommand", "Bracket", "BracketCommand", "CombiningFunction", "EmptyCommand",
	"FontFunction", "Formula", "FormulaNumber", "FormulaSymbol", "OneParamFunction",
	"OversetFunction", "RawText", "SpacedCommand", "SymbolFunction", "TextFunction",
	"UndersetFunction",
}
