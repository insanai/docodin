package transforms

import "core:encoding/json"
import "core:fmt"
import "core:os"
import "core:strings"
import "core:time"

import dt "../doctree"

// ``docutils.transforms.universal``: transforms needed by most or all
// documents (``SmartQuotes`` is in smartquotes.odin).

// --- Decorations -------------------------------------------------------------

// ``Decorations``: the footer with a source link, datestamp and generator
// credit, as configured (no header).
decorations :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	footer_nodes := generate_footer(r)
	if footer_nodes == 0 do return
	footer := dt.get_footer(doc, dt.get_decoration(doc))
	dt.append_child(doc, footer, footer_nodes)
}

@(private = "file")
reference :: proc(doc: ^dt.Doc, text, refuri: string) -> dt.Node {
	ref := dt.new_element(doc, .reference, "", text)
	dt.set_attr(doc, ref, dt.K_REFURI, refuri)
	return ref
}

// The footer paragraph, 0 if there is nothing to say.
@(private = "file")
generate_footer :: proc(r: ^Run) -> dt.Node {
	doc := r.doc
	s := &doc.settings
	source := source_setting(r)
	if !(s.generator || s.datestamp != "" || s.source_link || s.source_url != "") do return 0
	text := make([dynamic]dt.Node, 0, 8, context.temp_allocator)
	ta := context.temp_allocator
	if (s.source_link && source != "") || s.source_url != "" {
		uri := s.source_url
		if uri == "" do uri = relative_path(output_path(doc), source)
		append(&text, reference(doc, "View document source", uri), dt.new_text(doc, ".\n"))
	}
	if s.datestamp != "" {
		now := r.options.now.? or_else time.now()
		stamp := strftime(s.datestamp, now)
		append(&text, dt.new_text(doc, strings.concatenate({"Generated on: ", stamp, ".\n"}, ta)))
	}
	if s.generator {
		append(&text, dt.new_text(doc, "Generated by "))
		append(&text, reference(doc, "Docutils", "https://docutils.sourceforge.io/"))
		append(&text, dt.new_text(doc, " from "))
		rst_uri := "https://docutils.sourceforge.io/rst.html"
		append(&text, reference(doc, "reStructuredText", rst_uri))
		append(&text, dt.new_text(doc, " source.\n"))
	}
	para := dt.new_element(doc, .paragraph)
	dt.extend_children(doc, para, text[:])
	return para
}

@(private = "file")
output_path :: proc(doc: ^dt.Doc) -> string {
	v, _ := raw_setting(doc, "output_path")
	return string(v.(json.String) or_else "")
}

// ``utils.relative_path(source, target)`` (POSIX paths): the path of
// ``target`` relative to the directory of the file ``source`` ("" is
// ``dummy_file`` in the current directory).
relative_path :: proc(source, target: string) -> string {
	ta := context.temp_allocator
	src := abspath(source if source != "" else "dummy_file")
	tgt := abspath(target)
	sp := strings.split(src, "/", ta)
	tp := strings.split(tgt, "/", ta)
	if len(sp) < 2 || len(tp) < 2 || sp[0] != tp[0] || sp[1] != tp[1] {
		return strings.join(tp, "/", ta)
	}
	i := 0
	for i < len(sp) && i < len(tp) && sp[i] == tp[i] do i += 1
	parts := make([dynamic]string, 0, len(tp), ta)
	for _ in 0 ..< len(sp) - i - 1 do append(&parts, "..")
	append(&parts, ..tp[i:])
	return strings.join(parts[:], "/", ta)
}

// ``os.path.abspath(path)`` (``normpath`` of the path joined to the
// current directory).
abspath :: proc(path: string) -> string {
	ta := context.temp_allocator
	full := path
	if !strings.has_prefix(path, "/") {
		cwd, _ := os.get_working_directory(ta)
		full = strings.concatenate({cwd, "/", path}, ta)
	}
	parts := make([dynamic]string, 0, 16, ta)
	for p in strings.split(full, "/", ta) {
		switch p {
		case "", ".":
		case "..":
			if len(parts) > 0 do pop(&parts)
		case:
			append(&parts, p)
		}
	}
	return strings.concatenate({"/", strings.join(parts[:], "/", ta)}, ta)
}

// --- ExposeInternals ---------------------------------------------------------

// ``ExposeInternals``: ``node['internal:' + att] = getattr(node, att)``
// for the Python attributes of the ``expose_internals`` setting that are
// not None (and have a plain value).
expose_internals :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	names := doc.settings.expose_internals
	if len(names) == 0 do return
	it := dt.findall(doc, doc.root, ELEMENTS)
	for n in dt.next(&it) {
		for att in names {
			value, ok := internal_attribute(doc, n, att)
			if !ok do continue
			key := strings.concatenate({"internal:", att}, context.temp_allocator)
			dt.set_attr(doc, n, key, value)
		}
	}
}

// Every element class (``nodes.Element``).
ELEMENTS :: ~dt.Tag_Set{.Text} & ALL_TAGS

@(private = "file")
ALL_TAGS :: dt.Tag_Set{
	.Text, .abbreviation, .acronym, .address, .admonition, .attention, .attribution, .author,
	.authors, .block_quote, .bullet_list, .caption, .caution, .citation, .citation_reference,
	.classifier, .colspec, .comment, .compound, .contact, .container, .copyright, .danger,
	.date, .decoration, .definition, .definition_list, .definition_list_item, .description,
	.docinfo, .doctest_block, .document, .emphasis, .entry, .enumerated_list, .error, .field,
	.field_body, .field_list, .field_name, .figure, .footer, .footnote, .footnote_reference,
	.generated, .header, .hint, .image, .important, .inline, .label, .legend, .line,
	.line_block, .list_item, .literal, .literal_block, .math, .math_block, .meta, .note,
	.option, .option_argument, .option_group, .option_list, .option_list_item,
	.option_string, .organization, .paragraph, .pending, .problematic, .raw, .reference,
	.revision, .row, .rubric, .section, .sidebar, .status, .strong, .subscript,
	.substitution_definition, .substitution_reference, .subtitle, .superscript,
	.system_message, .table, .target, .tbody, .term, .tgroup, .thead, .tip, .title,
	.title_reference, .topic, .transition, .version, .warning, .Element,
}

// ``getattr(node, att, None)`` of the node attributes the interchange can
// represent.
@(private = "file")
internal_attribute :: proc(doc: ^dt.Doc, n: dt.Node, att: string) -> (dt.Attr_Value, bool) {
	switch att {
	case "line":
		if l, ok := dt.line(doc, n); ok do return l, true
	case "source":
		if s, ok := dt.source(doc, n); ok do return s, true
	case "rawsource":
		return dt.text(doc, n), true
	case "tagname":
		return dt.tagname(doc, n), true
	case "referenced":
		return flag_attribute(doc, n, .Referenced, .Targetable, 0)
	case "resolved":
		return flag_attribute(doc, n, .Resolved, .Resolvable, false)
	}
	return internal_state(doc, n, att)
}

// ``indent`` and ``indirect_reference_name`` (``Node_Internals``).
@(private = "file")
internal_state :: proc(doc: ^dt.Doc, n: dt.Node, att: string) -> (dt.Attr_Value, bool) {
	ni := doc.internals[n]
	switch att {
	case "indent":
		if i, ok := ni.indent.?; ok do return i, true
	case "indirect_reference_name":
		if s, ok := ni.indirect_reference_name.?; ok do return s, true
	}
	return nil, false
}

// ``referenced``/``resolved``: True once set, else the class attribute
// (``Targetable.referenced = 0``, ``Resolvable.resolved = False``; None for
// other classes).
@(private = "file")
flag_attribute :: proc(
	doc: ^dt.Doc,
	n: dt.Node,
	f: dt.Node_Flag,
	c: dt.Category,
	default: dt.Attr_Value,
) -> (
	dt.Attr_Value,
	bool,
) {
	if dt.has_flag(doc, n, f) do return true, true
	if dt.is_a(doc, n, c) do return default, true
	return nil, false
}

// --- messages ----------------------------------------------------------------------

// ``Messages``: loose system messages (not in the tree) go into a
// "Docutils System Messages" section at the end.
messages :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	loose := make([dynamic]dt.Node, 0, 8, context.temp_allocator)
	for m in doc.parse_messages do if dt.parent(doc, m) == 0 do append(&loose, m)
	for m in doc.transform_messages do if dt.parent(doc, m) == 0 do append(&loose, m)
	if len(loose) == 0 do return
	section := dt.new_element(doc, .section)
	dt.set_list(doc, section, dt.K_CLASSES, "system-messages")
	dt.append_child(doc, section, dt.new_element(doc, .title, "", "Docutils System Messages"))
	dt.extend_children(doc, section, loose[:])
	clear(&doc.transform_messages)
	dt.append_child(doc, doc.root, section)
}

// ``FilterMessages``: remove system messages below the report level (and
// their ids), turn problematic references to them into text, and remove
// an empty messages section.
filter_messages :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	removed := make([dynamic]dt.Str, 0, 8, context.temp_allocator)
	for n in dt.traverse(doc, doc.root, dt.Tag_Set{.system_message}) {
		if dt.get_int(doc, n, dt.K_LEVEL) >= doc.reporter.report_level do continue
		py_remove(r, n)
		for id in dt.attr_list(doc, n, dt.K_IDS) {
			dt.om_delete(&doc.ids, id)
			append(&removed, id)
		}
	}
	for n in dt.traverse(doc, doc.root, dt.Tag_Set{.problematic}) {
		refid, has := dt.get_attr(doc, n, dt.K_REFID)
		s, is_str := refid.(string)
		if !has || !is_str || !contains_str(doc, removed[:], s) do continue
		dt.replace(doc, dt.parent(doc, n), n, dt.new_text(doc, dt.astext(doc, n)))
	}
	it := dt.findall(doc, doc.root, dt.Tag_Set{.section})
	for n in dt.next(&it) {
		if dt.list_contains(doc, n, dt.K_CLASSES, "system-messages") && length(doc, n) == 1 {
			py_remove(r, n)
		}
	}
}

@(private = "file")
contains_str :: proc(doc: ^dt.Doc, list: []dt.Str, s: string) -> bool {
	for x in list do if dt.str(doc, x) == s do return true
	return false
}

// ``TestMessages``: append the loose transform messages to the document.
test_messages :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	for m in doc.transform_messages {
		if dt.parent(doc, m) == 0 do dt.append_child(doc, doc.root, m)
	}
}

// --- stripping -------------------------------------------------------------------

// ``StripComments``: remove comments with ``strip_comments``.
strip_comments :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	if !doc.settings.strip_comments do return
	for n in dt.traverse(doc, doc.root, dt.Tag_Set{.comment}) {
		py_remove(r, n)
	}
}

// ``StripClassesAndElements``: remove the elements that have a class of
// ``strip_elements_with_classes``, and the classes of ``strip_classes``.
strip_classes :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	s := &doc.settings
	if len(s.strip_elements_with_classes) > 0 {
		cond := dt.Predicate{has_stripped_class, &s.strip_elements_with_classes}
		for n in dt.traverse(doc, doc.root, cond) {
			py_remove(r, n)
		}
	}
	if len(s.strip_classes) == 0 do return
	it := dt.findall(doc, doc.root, ELEMENTS)
	for n in dt.next(&it) {
		for class in s.strip_classes do dt.list_remove(doc, n, dt.K_CLASSES, class)
	}
}

@(private = "file")
has_stripped_class :: proc(doc: ^dt.Doc, n: dt.Node, data: rawptr) -> bool {
	if dt.tag(doc, n) == .Text do return false
	strip := (^[]string)(data)^
	for c in dt.attr_list(doc, n, dt.K_CLASSES) {
		for s in strip do if dt.str(doc, c) == s do return true
	}
	return false
}

// --- Validate ------------------------------------------------------------------------

// ``Validate``: with the ``validate`` setting, a warning for each node that
// does not conform to the Docutils document model.
validate_document :: proc(r: ^Run, _: dt.Node, _: []dt.Detail) {
	doc := r.doc
	if !doc.settings.validate do return
	it := dt.findall(doc, doc.root)
	for n in dt.next(&it) {
		ok, message, problematic := dt.validate(doc, n, recursive = false)
		if ok do continue
		dt.warning(doc, message, {base_node = problematic if problematic != 0 else n})
	}
}

// --- strftime --------------------------------------------------------------------

@(private = "file")
MONTHS := [12]string {
	"January", "February", "March", "April", "May", "June", "July", "August", "September",
	"October", "November", "December",
}

@(private = "file")
WEEKDAYS := [7]string{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}

// ``time.strftime(format, time.gmtime())`` for the common directives; others
// are copied.
strftime :: proc(format: string, t: time.Time) -> string {
	b := strings.builder_make(context.temp_allocator)
	for i := 0; i < len(format); i += 1 {
		if format[i] != '%' || i + 1 == len(format) {
			strings.write_byte(&b, format[i])
			continue
		}
		i += 1
		write_directive(&b, format[i], t)
	}
	return strings.to_string(b)
}

@(private = "file")
Stamp_Field :: enum u8 {
	Year,
	Year2,
	Month,
	Day,
	Hour,
	Hour12,
	Minute,
	Second,
	Yday,
}

// The numeric directives: field, width and padding (``%e`` pads with a space).
@(private = "file")
NUMERIC_DIRECTIVES := [?]struct {
	c:     u8,
	field: Stamp_Field,
	width: int,
	pad:   u8,
} {
	{'Y', .Year, 1, '0'},
	{'y', .Year2, 2, '0'},
	{'m', .Month, 2, '0'},
	{'d', .Day, 2, '0'},
	{'e', .Day, 2, ' '},
	{'H', .Hour, 2, '0'},
	{'I', .Hour12, 2, '0'},
	{'M', .Minute, 2, '0'},
	{'S', .Second, 2, '0'},
	{'j', .Yday, 3, '0'},
}

@(private = "file")
write_directive :: proc(b: ^strings.Builder, c: u8, t: time.Time) {
	year, month, day := time.date(t)
	hour, minute, second := time.clock(t)
	values := [Stamp_Field]int {
		.Year   = year,
		.Year2  = year % 100,
		.Month  = int(month),
		.Day    = day,
		.Hour   = hour,
		.Hour12 = (hour + 11) % 12 + 1,
		.Minute = minute,
		.Second = second,
		.Yday   = day_of_year(t),
	}
	for d in NUMERIC_DIRECTIVES {
		if d.c != c do continue
		digits := fmt.tprintf("%d", values[d.field])
		for _ in len(digits) ..< d.width do strings.write_byte(b, d.pad)
		strings.write_string(b, digits)
		return
	}
	weekday := WEEKDAYS[int(time.weekday(t))]
	switch c {
	case 'p': strings.write_string(b, "AM" if hour < 12 else "PM")
	case 'B': strings.write_string(b, MONTHS[int(month) - 1])
	case 'b': strings.write_string(b, MONTHS[int(month) - 1][:3])
	case 'A': strings.write_string(b, weekday)
	case 'a': strings.write_string(b, weekday[:3])
	case 'Z': strings.write_string(b, "UTC")
	case '%': strings.write_byte(b, '%')
	case:
		strings.write_byte(b, '%')
		strings.write_byte(b, c)
	}
}

@(private = "file")
day_of_year :: proc(t: time.Time) -> int {
	year, _, _ := time.date(t)
	start, _ := time.datetime_to_time(year, 1, 1, 0, 0, 0)
	return int(time.diff(start, t) / (24 * time.Hour)) + 1
}
