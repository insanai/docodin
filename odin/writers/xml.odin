package writers

import "base:runtime"
import "core:strings"

import dt "../doctree"

// The pseudo-XML writer (``writers.pseudoxml``: ``document.pformat()``) and
// the Docutils XML writer (``writers.docutils_xml``).

write_pseudoxml :: proc(doc: ^dt.Doc, s: Settings, allocator: runtime.Allocator) -> Result {
	res := Result {
		output = dt.pformat(doc, doc.root, allocator = allocator),
	}
	settings := s
	base_parts(&res, &settings, allocator)
	return res
}

XML_DOCTYPE ::
	`<!DOCTYPE document PUBLIC` +
	` "+//IDN docutils.sourceforge.net//DTD Docutils Generic//EN//XML"` +
	` "http://docutils.sourceforge.net/docs/ref/docutils.dtd">` +
	"\n"

Xml_Translator :: struct {
	doc:        ^dt.Doc,
	settings:   ^Settings,
	out:        strings.Builder,
	indent:     string,
	newline:    string,
	level:      int,
	in_simple:  int, // nesting level inside mixed-content elements
	fixed_text: int, // nesting level inside FixedText elements
	err:        string,
}

@(private = "file")
XML_SIMPLE := dt.Tag_Set{.meta, .image, .colspec, .transition}

@(private = "file")
xml_dispatch: Dispatch(Xml_Translator)

@(init, private = "file")
init_xml_dispatch :: proc "contextless" () {
	for t in dt.Tag {
		xml_dispatch.visit[t] = xml_default_visit
		xml_dispatch.depart[t] = xml_default_departure
	}
	xml_dispatch.visit[.Text] = xml_visit_text
	xml_dispatch.depart[.Text] = nil
	xml_dispatch.visit[.raw] = xml_visit_raw
	xml_dispatch.names = &XML_METHOD_NAMES
}

// ``utils.xml_declaration(encoding)``.
xml_declaration :: proc(encoding: string) -> string {
	if encoding == "" || strings.to_lower(encoding, context.temp_allocator) == "unicode" {
		return `<?xml version="1.0"?>` + "\n"
	}
	return strings.concatenate({`<?xml version="1.0" encoding="`, encoding, `"?>` + "\n"})
}

write_xml :: proc(doc: ^dt.Doc, s: Settings, allocator: runtime.Allocator) -> Result {
	settings := s
	t := Xml_Translator {
		doc      = doc,
		settings = &settings,
		out      = strings.builder_make(allocator),
	}
	if settings.newlines do t.newline = "\n"
	if settings.indents {
		t.newline = "\n"
		t.indent = "    "
	}
	if settings.xml_declaration {
		strings.write_string(&t.out, xml_declaration(settings.output_encoding))
	}
	if settings.doctype_declaration do strings.write_string(&t.out, XML_DOCTYPE)
	strings.write_string(&t.out, "<!-- Generated by Docutils " + DOCUTILS_VERSION + " -->\n")
	walkabout(&t, &xml_dispatch, doc.root)
	res := Result {
		output = strings.to_string(t.out),
		err    = t.err,
	}
	base_parts(&res, &settings, allocator)
	return res
}

@(private = "file")
is_simple :: proc(doc: ^dt.Doc, n: dt.Node) -> bool {
	return dt.is_a(doc, n, .TextElement) || dt.is(doc, n, XML_SIMPLE)
}

@(private = "file")
is_fixed :: proc(doc: ^dt.Doc, n: dt.Node) -> bool {
	return dt.is_a(doc, n, .FixedTextElement) || dt.tag(doc, n) == .literal
}

@(private = "file")
write_indent :: proc(t: ^Xml_Translator) {
	for _ in 0 ..< t.level do strings.write_string(&t.out, t.indent)
}

@(private = "file")
xml_default_visit :: proc(t: ^Xml_Translator, n: dt.Node) -> Visit {
	if t.in_simple == 0 do write_indent(t)
	write_xml_starttag(&t.out, t.doc, n)
	if !dt.is_a(t.doc, n, .Inline) do t.level += 1
	if is_fixed(t.doc, n) do t.fixed_text += 1
	if is_simple(t.doc, n) do t.in_simple += 1
	if t.in_simple == 0 do strings.write_string(&t.out, t.newline)
	return .Continue
}

@(private = "file")
xml_default_departure :: proc(t: ^Xml_Translator, n: dt.Node) {
	if !dt.is_a(t.doc, n, .Inline) do t.level -= 1
	if t.in_simple == 0 do write_indent(t)
	strings.write_string(&t.out, "</")
	strings.write_string(&t.out, dt.tagname(t.doc, n))
	strings.write_byte(&t.out, '>')
	if is_fixed(t.doc, n) do t.fixed_text -= 1
	if is_simple(t.doc, n) do t.in_simple -= 1
	if t.in_simple == 0 do strings.write_string(&t.out, t.newline)
}

@(private = "file")
xml_visit_text :: proc(t: ^Xml_Translator, n: dt.Node) -> Visit {
	text := astext(t.doc, n)
	for i in 0 ..< len(text) {
		c := text[i]
		switch c {
		case '&':
			strings.write_string(&t.out, "&amp;")
		case '<':
			strings.write_string(&t.out, "&lt;")
		case '>':
			strings.write_string(&t.out, "&gt;")
		case '\n':
			strings.write_byte(&t.out, '\n')
			if t.fixed_text == 0 do write_indent(t)
		case:
			strings.write_byte(&t.out, c)
		}
	}
	return .Continue
}

@(private = "file")
xml_visit_raw :: proc(t: ^Xml_Translator, n: dt.Node) -> Visit {
	xml_default_visit(t, n)
	if !format_has(attr(t.doc, n, "format"), "xml") do return .Continue
	strings.write_string(&t.out, astext(t.doc, n))
	xml_default_departure(t, n)
	return .Skip_Node
}

// ``"word" in value.split()``.
format_has :: proc(value, word: string) -> bool {
	rest := value
	for f in strings.fields_iterator(&rest) {
		if f == word do return true
	}
	return false
}

// ``Element.starttag(xml.sax.saxutils.quoteattr)``.
@(private = "file")
write_xml_starttag :: proc(b: ^strings.Builder, doc: ^dt.Doc, n: dt.Node) {
	strings.write_byte(b, '<')
	strings.write_string(b, dt.tagname(doc, n))
	for a in dt.attlist(doc, n) {
		strings.write_byte(b, ' ')
		strings.write_string(b, a.key)
		strings.write_byte(b, '=')
		if _, is_none := a.value.(dt.Attr_None); is_none {
			strings.write_string(b, `"True"`)
			continue
		}
		vb := strings.builder_make(context.temp_allocator)
		dt.write_attr_value(&vb, doc, a.value)
		write_quoteattr(b, strings.to_string(vb))
	}
	strings.write_byte(b, '>')
}

// ``xml.sax.saxutils.quoteattr``.
write_quoteattr :: proc(b: ^strings.Builder, value: string) {
	has_dq := strings.index_byte(value, '"') >= 0
	has_sq := strings.index_byte(value, '\'') >= 0
	q: u8 = '\'' if has_dq && !has_sq else '"'
	strings.write_byte(b, q)
	for i in 0 ..< len(value) {
		c := value[i]
		switch c {
		case '&':
			strings.write_string(b, "&amp;")
		case '<':
			strings.write_string(b, "&lt;")
		case '>':
			strings.write_string(b, "&gt;")
		case '\n':
			strings.write_string(b, "&#10;")
		case '\r':
			strings.write_string(b, "&#13;")
		case '\t':
			strings.write_string(b, "&#9;")
		case '"':
			strings.write_string(b, "&quot;" if q == '"' else "\"")
		case:
			strings.write_byte(b, c)
		}
	}
	strings.write_byte(b, q)
}
