// Does the option take a value?
takes_value :: proc(o: ^Option) -> bool {
	#partial switch o.action {
	case .Store, .Append, .Warnings, .Unsupported:
		return o.metavar != ""
	}
	return false
}

// The option named ``name`` for ``writer`` (nil if there is none).
find_option :: proc(name: string, writer: wr.Writer_Name) -> ^Option {
	for &o in OPTIONS {
		if o.writers != {} && writer not_in o.writers do continue
		if has_word(o.names, name) do return &o
	}
	return nil
}

// The writers that have an option ``name`` ({} for none).
option_writers :: proc(name: string) -> Writers {
	ws: Writers
	for o in OPTIONS {
		if has_word(o.names, name) do ws += o.writers if o.writers != {} else ALL
	}
	return ws
}

// Is ``word`` one of the space-separated ``words``?
has_word :: proc(words, word: string) -> bool {
	rest := words
	for w in strings.fields_iterator(&rest) do if w == word do return true
	return false
}

// The space-separated ``words`` as a list.
word_list :: proc(words: string) -> []string {
	return strings.fields(words, context.temp_allocator)
}
