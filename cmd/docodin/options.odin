package main

import "core:strings"

import pb "../../odin/publish"
import wr "../../odin/writers"

// The command-line options of docutils' front end (``frontend.OptionParser``
// and the settings specs of the rST parser, the standalone reader and the
// writers), as ``docutils --writer=NAME`` accepts them.

Writers :: bit_set[wr.Writer_Name]

ALL :: Writers{.Pseudoxml, .Xml, .Html5, .Latex, .Xetex}
HTML :: Writers{.Html5}
LATEX :: Writers{.Latex, .Xetex}
HTML_LATEX :: Writers{.Html5, .Latex, .Xetex}

// What an option does with the setting ``dest`` (``optparse`` actions).
Action :: enum u8 {
	Store, // the value, converted by the setting's validator
	Store_True,
	Store_False,
	Store_Const, // ``const``
	Append, // the value's items added to the list
	No_Source_Link, // ``source_link`` and ``source_url`` set to None
	Warnings, // the file the messages are written to
	Ignore, // accepted without effect (``--traceback``)
	Unsupported, // needs Python (``--config``, ``--dump-*``)
	Help,
	Version,
	Graphviz,
}

Const :: union {
	pb.None,
	bool,
	int,
	string,
}

Option :: struct {
	names:     string, // separated by spaces
	dest:      string,
	action:    Action,
	writers:   Writers, // {}: every writer
	metavar:   string, // the value's placeholder; "" for flags
	help:      string,
	choices:   string, // separated by spaces
	const:     Const,
	overrides: string, // a setting the option resets to None
}

@(private = "file")
LEVELS :: "info warning error severe none 1 2 3 4 5"

// Every option, in the order of ``--help``.
@(rodata)
